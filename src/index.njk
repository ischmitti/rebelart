<script>
        window.addEventListener("load", function () {
                gsap.set(".flair", { xPercent: 1, yPercent: -1 });
                let xSetter = gsap.quickSetter(".flair", "x", "px") //apply it to the #id element's x property and append a "px" unit
                let ySetter = gsap.quickSetter(".flair", "y", "px") //apply it to the #id element's x property and append a "px" unit
                const width = window.innerWidth;
                const height = window.innerHeight;
                const herowrap = document.querySelector(".hero-img-wrap");
                document.querySelector("body").addEventListener("mousemove", (e) => {
                        let x = e.clientX * 0.01;
                        let y = e.clientY * 0.01;
                        herowrap.style.transform = "translate(" + x + "px," + y + "px)";
                })
                document.querySelector(".h1-wrapper").addEventListener("mousemove", e => {
                        xSetter(e.x)
                        ySetter(e.y)
                });
                document.querySelector(".a1").addEventListener("mouseenter", e => {
                        document.querySelector(".flair").style.width = "500px;"
                })
                document.querySelector(".a1").addEventListener("mouseleave", () => {
                })
                document.querySelector(".a2").addEventListener("mouseover", () => {
                        document.querySelector(".h1-wrapper").classList.add("trigger")
                        document.querySelector(".h1-wrapper").classList.add("triggerposter")
                })
                document.querySelector(".a2").addEventListener("mouseleave", () => {
                        document.querySelector(".h1-wrapper").classList.remove("triggerposter")
                        // setTimeout(() => {
                        document.querySelector(".h1-wrapper").classList.remove("trigger")
                        // }, 500);
                })
                document.querySelector(".a3").addEventListener("mouseover", () => {
                        document.querySelector(".h1-wrapper").classList.add("trigger")
                        document.querySelector(".h1-wrapper").classList.add("triggerabout")
                })
                document.querySelector(".a3").addEventListener("mouseleave", () => {
                        document.querySelector(".h1-wrapper").classList.remove("triggerabout")
                        // setTimeout(() => {
                        document.querySelector(".h1-wrapper").classList.remove("trigger")
                        // }, 500);
                })
        });
</script>